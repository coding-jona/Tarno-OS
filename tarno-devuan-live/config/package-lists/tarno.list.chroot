# openrc-init is selected via the init= kernel param in auto/config;
# devuan's default init (sysvinit) stays untouched.
openrc

# isolinux.bin moved into its own package when syslinux split in 2014;
# this live-build's package check doesn't know that, so pull it in by hand.
isolinux

# dhcpcd probes every interface it finds and doesn't need to know real
# interface names ahead of time - needed for tarnod's mistral calls to
# reach the internet at all. wifi (wpa_supplicant + firmware) isn't
# wired up yet.
dhcpcd5

# isohybrid moved into its own package too (same 2014 syslinux split as
# isolinux above). lb_binary_iso's own check for it only looks for the
# `syslinux` package (Check_package chroot/usr/bin/isohybrid syslinux),
# which doesn't ship isohybrid anymore either - same class of stale
# check, so pull it in by hand like isolinux.
syslinux-utils

# desktop: labwc (minimal wlroots/openbox-alike compositor with a real
# root-menu, see config/includes.chroot/etc/xdg/labwc/) + seatd (seat
# management without systemd-logind) + foot (minimal wayland terminal,
# also the menu's Terminal entry).
labwc
seatd
foot

# settings panel (config/includes.chroot/usr/bin/tarno-settings)
python3
python3-pyside6.qtcore
python3-pyside6.qtgui
python3-pyside6.qtwidgets
