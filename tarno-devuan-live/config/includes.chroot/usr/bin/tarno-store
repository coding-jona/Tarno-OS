"""

# name, apt package, category, one-line description, icon-theme name
# hint (usually == package, called out otherwise) - real, well-known
# packages, nothing from a third-party repo (this only ever runs plain
# `apt-get install/remove` against what's already in sources.list).
CATALOG = [
    ("Thunderbird", "thunderbird", "Internet", "E-Mail client", "thunderbird"),
    ("qBittorrent", "qbittorrent", "Internet", "BitTorrent client", "qbittorrent"),
    ("HexChat", "hexchat", "Internet", "IRC client", "hexchat"),
    ("Remmina", "remmina", "Internet", "Remote desktop client (RDP/VNC/SSH)", "remmina"),
    ("LibreOffice", "libreoffice", "Office", "Full office suite", "libreoffice-startcenter"),
    ("Evince", "evince", "Office", "PDF and document viewer", "evince"),
    ("GIMP", "gimp", "Graphics", "Image editor", "gimp"),
    ("Inkscape", "inkscape", "Graphics", "Vector graphics editor", "inkscape"),
    ("imv", "imv", "Graphics", "Minimal Wayland-native image viewer", "imv"),
    ("VLC", "vlc", "Media", "Plays almost any audio/video format", "vlc"),
    ("mpv", "mpv", "Media", "Minimal, high-quality video player", "mpv"),
    ("Audacity", "audacity", "Media", "Audio editor", "audacity"),
    ("Neovim", "neovim", "Development", "Modern vim-based text editor", "nvim"),
    ("Git", "git", "Development", "Version control", "git"),
    ("htop", "htop", "System", "Interactive process viewer", "utilities-system-monitor"),
    ("neofetch", "neofetch", "System", "System info at a glance", "utilities-terminal"),
    ("GParted", "gparted", "System", "Partition editor", "gparted"),
    ("Filelight", "filelight", "System", "Disk usage analyzer", "filelight"),
    ("Galculator", "galculator", "Utilities", "Calculator", "accessories-calculator"),
    ("Flameshot", "flameshot", "Utilities", "Screenshot tool with annotations", "flameshot"),
]

FALLBACK_ICON = "application-x-executable"


def is_installed(package):
    return (
        subprocess.run(
            ["dpkg-query", "-W", "-f=${Status}", package],
            capture_output=True,
            text=True,
            check=False,
        ).stdout.strip()
        == "install ok installed"
    )


def app_icon(icon_name):
    icon = QIcon.fromTheme(icon_name)
    if icon.isNull():
        icon = QIcon.fromTheme(FALLBACK_ICON)
    return icon


class AppRow(QFrame):
    def __init__(self, name, package, category, description, icon_name, log):
        super().__init__()
        self.setObjectName("appCard")
        self.package = package
        self.log = log
        self.process = None

        icon_label = QLabel()
        icon_label.setObjectName("appIcon")
        icon_label.setFixedSize(44, 44)
        icon_label.setAlignment(Qt.AlignmentFlag.AlignCenter)
        icon_label.setPixmap(app_icon(icon_name).pixmap(QSize(28, 28)))

        title = QLabel(name)
        title.setObjectName("appName")
        chip = QLabel(category.upper())
        chip.setObjectName("categoryChip")
        desc = QLabel(description)
        desc.setObjectName("appDescription")

        head = QHBoxLayout()
        head.setSpacing(8)
        head.addWidget(title)
        head.addWidget(chip)
        head.addStretch()

        text_col = QVBoxLayout()
        text_col.setSpacing(3)
        text_col.addLayout(head)
        text_col.addWidget(desc)

        self.button = QPushButton()
        self.button.setFixedWidth(92)
        self.button.clicked.connect(self.toggle)
        self.refresh_button()

        layout = QHBoxLayout(self)
        layout.setContentsMargins(14, 12, 14, 12)
        layout.setSpacing(14)
        layout.addWidget(icon_label)
        layout.addLayout(text_col, 1)
        layout.addWidget(self.button)

    def refresh_button(self):
        if is_installed(self.package):
            self.button.setText("Remove")
            self.button.setProperty("role", "danger")
        else:
            self.button.setText("Install")
            self.button.setProperty("role", "")
        self.button.style().unpolish(self.button)
        self.button.style().polish(self.button)

    def toggle(self):
        action = "remove" if is_installed(self.package) else "install"
        self.button.setEnabled(False)
        self.button.setText("...")
        self.log.appendPlainText(f"$ apt-get {action} -y {self.package}")

        self.process = QProcess(self)
        env = self.process.processEnvironment()
        env.insert("DEBIAN_FRONTEND", "noninteractive")
        self.process.setProcessEnvironment(env)
        self.process.setProgram("sudo")
        self.process.setArguments(["-n", "apt-get", action, "-y", self.package])
        self.process.readyReadStandardOutput.connect(self._read_stdout)
        self.process.readyReadStandardError.connect(self._read_stderr)
        self.process.finished.connect(self._finished)
        self.process.start()

    def _read_stdout(self):
        data = bytes(self.process.readAllStandardOutput()).decode(errors="replace")
        self.log.appendPlainText(data.rstrip())

    def _read_stderr(self):
        data = bytes(self.process.readAllStandardError()).decode(errors="replace")
        self.log.appendPlainText(data.rstrip())

    def _finished(self, exit_code, _status):
        self.log.appendPlainText(f"(exit {exit_code})")
        self.button.setEnabled(True)
        self.refresh_button()


class MainWindow(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Tarno Store")
        self.resize(680, 560)

        header = QFrame()
        header.setObjectName("header")
        title = QLabel("Tarno Store")
        title.setObjectName("headerTitle")
        subtitle = QLabel(f"{len(CATALOG)} curated apps - installs straight from apt")
        subtitle.setObjectName("headerSubtitle")
        header_text = QVBoxLayout()
        header_text.setSpacing(2)
        header_text.addWidget(title)
        header_text.addWidget(subtitle)
        header_layout = QHBoxLayout(header)
        header_layout.setContentsMargins(20, 16, 20, 16)
        header_layout.addLayout(header_text)

        self.search = QLineEdit()
        self.search.setPlaceholderText("Search apps...")
        self.search.textChanged.connect(self.filter_rows)

        self.list = QListWidget()
        self.list.setSpacing(8)
        self.list.setFrameShape(QFrame.Shape.NoFrame)

        self.log = QPlainTextEdit()
        self.log.setReadOnly(True)
        self.log.setPlaceholderText("Install/remove output shows up here.")

        self.rows = []
        for name, package, category, description, icon_name in CATALOG:
            item = QListWidgetItem(self.list)
            row = AppRow(name, package, category, description, icon_name, self.log)
            item.setSizeHint(row.sizeHint())
            self.list.addItem(item)
            self.list.setItemWidget(item, row)
            self.rows.append((item, name, category, description))

        splitter = QSplitter()
        splitter.setOrientation(Qt.Orientation.Vertical)
        splitter.addWidget(self.list)
        splitter.addWidget(self.log)
        splitter.setSizes([420, 110])

        body = QWidget()
        body_layout = QVBoxLayout(body)
        body_layout.setContentsMargins(20, 16, 20, 16)
        body_layout.setSpacing(12)
        body_layout.addWidget(self.search)
        body_layout.addWidget(splitter)

        central = QWidget()
        central_layout = QVBoxLayout(central)
        central_layout.setContentsMargins(0, 0, 0, 0)
        central_layout.setSpacing(0)
        central_layout.addWidget(header)
        central_layout.addWidget(body)
        self.setCentralWidget(central)

    def filter_rows(self, text):
        text = text.strip().lower()
        for item, name, category, description in self.rows:
            haystack = f"{name} {category} {description}".lower()
            item.setHidden(text not in haystack)


def main():
    if shutil.which("apt-get") is None:
        print("apt-get not found - Tarno Store needs a Debian/Devuan base", file=sys.stderr)
        sys.exit(1)

    app = QApplication(sys.argv)
    app.setDesktopFileName("tarno-store")
    QIcon.setThemeName("Papirus")
    app.setStyleSheet(STYLESHEET)
    win = MainWindow()
    win.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
