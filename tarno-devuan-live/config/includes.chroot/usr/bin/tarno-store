#!/usr/bin/env python3
"""Tarno Store - curated apt catalog + Flathub search for Tarno OS.

Not a real package repository browser (that's synaptic, on the root
menu) - the Curated tab is a small, hand-picked list of real apps
across the categories a usable desktop needs, installed/removed with a
couple of clicks via plain apt-get. The Flathub tab is the actual
"browse everything" complement for anything not in the curated list or
not packaged in Devuan's own repos at all - searches live against
Flathub's full catalog (thousands of apps) via `flatpak search`, not a
hardcoded list. Same palette throughout, so every Tarno app looks
alike.
"""
import shutil
import subprocess
import sys

from PySide6.QtCore import QProcess, QSize, Qt
from PySide6.QtGui import QIcon
from PySide6.QtWidgets import (
    QApplication,
    QFrame,
    QHBoxLayout,
    QLabel,
    QLineEdit,
    QListWidget,
    QListWidgetItem,
    QMainWindow,
    QPlainTextEdit,
    QPushButton,
    QSplitter,
    QTabWidget,
    QVBoxLayout,
    QWidget,
)

