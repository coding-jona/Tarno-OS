#!/usr/bin/env python3
"""Tarno Store - curated app catalog for Tarno OS.

Not a real package repository browser (that's synaptic, on the root
menu) - a small, hand-picked list of real apps across the categories a
usable desktop needs, installed/removed with a couple of clicks. Same
palette as tarno-settings, so every Tarno app looks alike.
"""
import shutil
import subprocess
import sys

from PySide6.QtCore import QProcess, QSize, Qt
from PySide6.QtGui import QIcon
from PySide6.QtWidgets import (
    QApplication,
    QFrame,
    QHBoxLayout,
    QLabel,
    QLineEdit,
    QListWidget,
    QListWidgetItem,
    QMainWindow,
    QPlainTextEdit,
    QPushButton,
    QSplitter,
    QVBoxLayout,
    QWidget,
)

BG_APP = "#191919"
BG_PANEL = "#232323"
BG_CARD = "#262626"
BG_CARD_HOVER = "#2c2c2c"
BG_WIDGET = "#333333"
BG_WIDGET_HOVER = "#3d3d3d"
BORDER = "rgba(255, 255, 255, 0.07)"
BORDER_STRONG = "rgba(255, 255, 255, 0.14)"
TEXT_PRIMARY = "#f3f3f3"
TEXT_MUTED = "#9a9a9a"
ACCENT = "#0bc7ff"
ACCENT_HOVER = "#33d1ff"
ACCENT_DIM = "rgba(11, 199, 255, 0.15)"
DANGER = "#ff6a5f"
DANGER_DIM = "rgba(255, 106, 95, 0.12)"

FONT_STACK = '"Inter", "Noto Sans", "Segoe UI", -apple-system, sans-serif'

STYLESHEET = f"""
