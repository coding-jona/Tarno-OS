#!/usr/bin/env python3
"""Tarno OS settings panel - talks to tarnod over its unix socket."""
import json
import socket
import subprocess
import sys

from PySide6.QtWidgets import (
    QApplication,
    QHBoxLayout,
    QLabel,
    QLineEdit,
    QMainWindow,
    QPlainTextEdit,
    QPushButton,
    QTabWidget,
    QVBoxLayout,
    QWidget,
)

SOCKET_PATH = "/run/tarnod.sock"

# Same tokens as tarno-store - every Tarno app should look like part of
# the same OS, not a pile of separately-styled Qt scripts.
BG_APP = "#191919"
BG_PANEL = "#232323"
BG_WIDGET = "#333333"
BG_WIDGET_HOVER = "#3d3d3d"
BORDER = "rgba(255, 255, 255, 0.07)"
BORDER_STRONG = "rgba(255, 255, 255, 0.14)"
TEXT_PRIMARY = "#f3f3f3"
TEXT_MUTED = "#9a9a9a"
ACCENT = "#0bc7ff"
ACCENT_HOVER = "#33d1ff"
DANGER = "#ff6a5f"

FONT_STACK = '"Inter", "Noto Sans", "Segoe UI", -apple-system, sans-serif'

STYLESHEET = f"""
* {{
    font-family: {FONT_STACK};
}}
QMainWindow, QWidget {{
    background: {BG_APP};
    color: {TEXT_PRIMARY};
    font-size: 13px;
}}
QTabWidget::pane {{
    border: 1px solid {BORDER};
    border-radius: 10px;
    background: {BG_PANEL};
    top: -1px;
}}
QTabBar::tab {{
    background: transparent;
    color: {TEXT_MUTED};
    font-weight: 600;
    padding: 9px 18px;
    margin-right: 2px;
}}
QTabBar::tab:selected {{
    color: {TEXT_PRIMARY};
    border-bottom: 2px solid {ACCENT};
}}
QTabBar::tab:hover:!selected {{
    color: {TEXT_PRIMARY};
}}
QPushButton {{
    background: {BG_WIDGET};
    border: 1px solid {BORDER_STRONG};
    border-radius: 8px;
    padding: 7px 16px;
    font-weight: 600;
}}
QPushButton:hover {{
    background: {BG_WIDGET_HOVER};
    border-color: {ACCENT_HOVER};
    color: {ACCENT_HOVER};
}}
QPushButton:pressed {{
    background: {BG_APP};
}}
QLineEdit, QPlainTextEdit {{
    background: {BG_WIDGET};
    border: 1px solid {BORDER_STRONG};
    border-radius: 8px;
    padding: 8px 10px;
    color: {TEXT_PRIMARY};
    selection-background-color: {ACCENT};
}}
QLineEdit:focus, QPlainTextEdit:focus {{
    border-color: {ACCENT};
}}
QLabel[role="muted"] {{
    color: {TEXT_MUTED};
}}
QLabel[role="danger"] {{
    color: {DANGER};
}}
QLabel[role="heading"] {{
    font-weight: 700;
    font-size: 13px;
    margin-top: 4px;
}}
QScrollBar:vertical {{
    background: transparent;
    width: 10px;
}}
QScrollBar::handle:vertical {{
    background: {BORDER_STRONG};
    border-radius: 5px;
    min-height: 24px;
}}
QScrollBar::handle:vertical:hover {{
    background: {ACCENT_HOVER};
}}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {{
    height: 0;
}}
"""


def call(cmd, text=""):
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.connect(SOCKET_PATH)
            s.sendall(json.dumps({"cmd": cmd, "text": text}).encode())
            s.shutdown(socket.SHUT_WR)
            chunks = []
            while True:
                chunk = s.recv(4096)
                if not chunk:
                    break
                chunks.append(chunk)
        return json.loads(b"".join(chunks))
    except (OSError, json.JSONDecodeError) as e:
        return {"ok": False, "error": f"tarnod unreachable: {e}"}


def restyle(label):
    label.style().unpolish(label)
    label.style().polish(label)


class StatusTab(QWidget):
    def __init__(self):
        super().__init__()
        self.label = QLabel("checking...")
        self.label.setProperty("role", "muted")
        refresh = QPushButton("Refresh")
        refresh.clicked.connect(self.refresh)

        layout = QVBoxLayout(self)
        layout.addWidget(self.label)
        layout.addWidget(refresh)
        layout.addStretch()
        self.refresh()

    def refresh(self):
        resp = call("status")
        if resp.get("ok"):
            self.label.setText(f"● {resp['data']}")
            self.label.setProperty("role", "")
        else:
            self.label.setText(f"● {resp.get('error', 'unknown error')}")
            self.label.setProperty("role", "danger")
        restyle(self.label)


class AiTab(QWidget):
    """API key setup lives here, not in the chat app (tarno-assistant) -
    matches the reference project this is modeled on (coding-jona/tarno):
    keys are configured in settings, never typed into the conversation
    itself. Keeps a quick ask/answer box below the key section too, so a
    freshly-saved key can be sanity-checked without opening a second app."""

    def __init__(self):
        super().__init__()
        key_heading = QLabel("Mistral API key")
        key_heading.setProperty("role", "heading")

        self.status_label = QLabel("checking...")
        self.status_label.setProperty("role", "muted")

        self.key_input = QLineEdit()
        self.key_input.setPlaceholderText("Paste your Mistral API key...")
        self.key_input.setEchoMode(QLineEdit.EchoMode.Password)
        self.key_input.returnPressed.connect(self.save_key)
        save_key = QPushButton("Save")
        save_key.clicked.connect(self.save_key)

        key_row = QHBoxLayout()
        key_row.addWidget(self.key_input, 1)
        key_row.addWidget(save_key)

        chat_heading = QLabel("Quick test")
        chat_heading.setProperty("role", "heading")

        self.input = QLineEdit()
        self.input.setPlaceholderText("Ask tarnod something...")
        self.input.returnPressed.connect(self.ask)
        ask = QPushButton("Ask")
        ask.clicked.connect(self.ask)
        ask_row = QHBoxLayout()
        ask_row.addWidget(self.input, 1)
        ask_row.addWidget(ask)

        self.output = QPlainTextEdit()
        self.output.setReadOnly(True)

        layout = QVBoxLayout(self)
        layout.addWidget(key_heading)
        layout.addWidget(self.status_label)
        layout.addLayout(key_row)
        layout.addWidget(chat_heading)
        layout.addLayout(ask_row)
        layout.addWidget(self.output)

        self.refresh_status()

    def refresh_status(self):
        resp = call("ai_status")
        if resp.get("ok") and resp.get("data") == "configured":
            self.status_label.setText("● configured")
            self.status_label.setProperty("role", "")
        elif resp.get("ok"):
            self.status_label.setText("● not configured - paste a key above")
            self.status_label.setProperty("role", "muted")
        else:
            self.status_label.setText(f"● {resp.get('error', 'unknown error')}")
            self.status_label.setProperty("role", "danger")
        restyle(self.status_label)

    def save_key(self):
        key = self.key_input.text().strip()
        if not key:
            return
        resp = call("set_api_key", key)
        if resp.get("ok"):
            self.key_input.clear()
        else:
            self.output.setPlainText("error: " + resp.get("error", "unknown error"))
        self.refresh_status()

    def ask(self):
        question = self.input.text().strip()
        if not question:
            return
        resp = call("ai", question)
        if resp.get("ok"):
            self.output.setPlainText(resp["data"])
        else:
            self.output.setPlainText("error: " + resp.get("error", "unknown error"))


class InstallTab(QWidget):
    """Wraps tarno-disk-install - the one thing tarnod itself can't do,
    since it needs a real terminal for rsync progress and the type-the-
    device-name confirmation prompt (see tarno-install-to-disk)."""

    def __init__(self):
        super().__init__()
        warn = QLabel(
            "Installs this running live system to an internal disk. "
            "Erases the target disk entirely."
        )
        warn.setProperty("role", "muted")
        warn.setWordWrap(True)

        self.disks = QPlainTextEdit()
        self.disks.setReadOnly(True)
        refresh = QPushButton("Refresh disk list")
        refresh.clicked.connect(self.refresh)
        install = QPushButton("Install to Disk...")
        install.clicked.connect(self.launch)

        layout = QVBoxLayout(self)
        layout.addWidget(warn)
        layout.addWidget(self.disks)
        layout.addWidget(refresh)
        layout.addWidget(install)
        self.refresh()

    def refresh(self):
        try:
            proc = subprocess.run(
                ["sudo", "tarno-disk-install"],
                capture_output=True,
                text=True,
                timeout=10,
                check=False,
            )
            text = (proc.stdout + proc.stderr).strip()
            self.disks.setPlainText(text or "no internal disks found")
        except (OSError, subprocess.SubprocessError) as e:
            self.disks.setPlainText(f"error: {e}")

    def launch(self):
        # Runs in its own terminal, not inline here - rsync's progress
        # output and the safety confirmation prompt both need a real
        # tty, not a Qt widget.
        subprocess.Popen(["foot", "-e", "tarno-install-to-disk"])


class MainWindow(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Tarno Settings")
        self.resize(480, 360)

        tabs = QTabWidget()
        tabs.addTab(StatusTab(), "Status")
        tabs.addTab(AiTab(), "AI")
        tabs.addTab(InstallTab(), "Install")
        self.setCentralWidget(tabs)


def main():
    app = QApplication(sys.argv)
    # Without this, Qt's wayland platform plugin falls back to
    # something derived from argv[0] for the xdg_toplevel app_id - and
    # since this runs as `python3 /usr/bin/tarno-settings` (the shebang
    # invokes the interpreter, not a compiled binary named
    # tarno-settings), that fallback is the Python interpreter itself.
    # Confirmed on a real boot: waybar's taskbar showed "Python (v3.13)"
    # instead of anything Tarno-related.
    app.setDesktopFileName("tarno-settings")
    app.setStyleSheet(STYLESHEET)
    win = MainWindow()
    win.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
