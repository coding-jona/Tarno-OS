#!/usr/bin/env python3
"""Tarno OS settings panel - talks to tarnod over its unix socket."""
import json
import re
import socket
import subprocess
import sys

from PySide6.QtCore import Qt, QProcess
from PySide6.QtWidgets import (
    QApplication,
    QHBoxLayout,
    QInputDialog,
    QLabel,
    QLineEdit,
    QListWidget,
    QListWidgetItem,
    QMainWindow,
    QMessageBox,
    QPlainTextEdit,
    QPushButton,
    QTabWidget,
    QVBoxLayout,
    QWidget,
)

SOCKET_PATH = "/run/tarnod.sock"

# Same tokens as tarno-store - every Tarno app should look like part of
# the same OS, not a pile of separately-styled Qt scripts.
