#!/sbin/openrc-run
# openrc-init here (via the init=/sbin/openrc-init kernel param) skips
# the usual sysvinit/initscripts boot chain that normally fixes up /tmp
# permissions on every Debian/Devuan boot (that's normally openrc's own
# `bootmisc` service, or initscripts' checkroot.sh on plain sysvinit -
# neither is wired into this image's runlevels). Without it /tmp keeps
# whatever bare `mkdir` permissions (0755 root:root) it happened to end
# up with, so any non-root process trying to write there - which is
# exactly what tarno-desktop.sh does - gets "Permission denied".
# Confirmed on a real boot.
#
# Also restores /etc/network/interfaces to loopback-only every boot.
# The file baked into the image (config/includes.chroot/etc/network/
# interfaces) IS correct on disk - confirmed by diffing the actual git
# source against a real boot - but live-config's own runtime network
# component regenerates it fresh on every boot (a stock `allow-hotplug
# eth0` / `iface eth0 inet dhcp` "just works out of the box" default),
# running before openrc-init/this service ever gets a chance, so
# there's no ordering trick that beats it - it has to be actively
# reverted instead. Confirmed on a real boot: `cat
# /etc/network/interfaces` showed exactly that stock content, and
# `dhcpcd` refused to start because of it ("... defines some
# interfaces that will use a DHCP client"), same failure class as the
# original bug this was meant to have already fixed at build time.
#
# Also adds `user` to the `video` group every boot. Root-caused by
# reading the real live-config/user-setup/seatd packages: live-config's
# own 0030-user-setup component (runs from the initramfs, before
# openrc-init/this service ever starts, so the account always already
# exists by the time this runs) explicitly overrides user-setup's
# default group list with an EMPTY string via debconf-set-selections
# (passwd/user-default-groups) unless a `live-config.user-default-
# groups=` kernel cmdline param says otherwise, which nothing in this
# image sets - so `user` ends up in zero supplementary groups, not even
# user-setup's own (video-less) built-in default. Debian/Devuan's
# packaged /etc/init.d/seatd runs `seatd -g video` (see /etc/default/
# seatd), which makes the seatd socket owned by the `video` group -
# without membership, labwc's libseat backend can't connect to it at
# all, labwc exits immediately, and since tarno-desktop.sh deliberately
# does NOT exec labwc (so a crash here is visible instead of silently
# bouncing back to login), that exit drops straight back into the
# interactive login shell. This is the actual cause of "I just end up
# in a shell" reports. A kernel-cmdline fix wouldn't reach a disk-
# installed system either (tarno-disk-install's GRUB_CMDLINE_LINUX_
# DEFAULT has no `boot=live`, so live-config - and any group list it'd
# assign - never runs again there); a `usermod` here, every boot, fixes
# both the live USB and anything already installed to disk, same
# "don't fight the timing, just win the last word" approach as the two
# fixups above.
description="Tarno OS early boot fixups (fix /tmp perms, /etc/network/interfaces, and user's video group before anything else runs)"

depend() {
	before agetty.tty1 dhcpcd
	keyword -prefix
}

start() {
	ebegin "Fixing /tmp, /var/tmp permissions"
	mkdir -p /tmp /var/tmp
	chmod 1777 /tmp /var/tmp
	eend $?

	ebegin "Resetting /etc/network/interfaces to loopback-only"
	cat >/etc/network/interfaces <<-'EOF'
	auto lo
	iface lo inet loopback
	EOF
	eend $?

	ebegin "Adding user to the video group (seatd's socket needs it)"
	usermod -aG video user 2>/dev/null
	eend $?
}
