#!/bin/sh
# Force every connected output to its actual preferred/native mode via
# wlr-randr, before anything else starts. Confirmed on a real boot:
# the whole desktop rendered squashed into a square aspect ratio -
# not caused by any config in this image (nothing here ever sets a
# resolution/mode anywhere), and labwc itself has no way to force a
# specific output mode on its own - its own manual says so explicitly,
# pointing at wlr-randr/kanshi instead. So whatever labwc's own
# auto-enable picked on this hardware wasn't the panel's real
# preferred mode. Reading the mode wlr-randr itself reports as
# "(preferred)" straight from the connector and forcing exactly that
# fixes this on whatever hardware it's run on, without hardcoding a
# resolution number that would be wrong on different hardware. A
# no-op (idempotent) if the preferred mode is already active.
if command -v wlr-randr >/dev/null 2>&1; then
	wlr-randr | awk '
		/^[^ ]/ { name = $1; next }
		/px,.*\(preferred/ { print name, $1 "@" $3 "Hz" }
	' | while read -r output mode; do
		wlr-randr --output "$output" --mode "$mode" 2>/dev/null || true
	done
fi

# labwc, like Openbox on X11, doesn't paint a desktop background itself
# - without a wallpaper client the whole screen is just black, which on
# a real boot is indistinguishable from "did this actually start at
# all?" (confirmed: that's exactly what a plain black screen after
# login looked like). swaybg is the minimal wlr-layer-shell wallpaper
# tool for this - fill with the theme's base dark-gray instead of
# nothing, so a working session is visibly a working session.
# Right-click still opens the menu.
swaybg -c '#202020' &

# waybar is a layer-shell panel, not a regular window - it reserves its
# own screen space via the wlr-layer-shell protocol, no labwc-side
# config needed for that. Config: config/includes.chroot/etc/xdg/waybar/
waybar &
