#!/bin/sh
# openrc-init doesn't get a console login for free - the openrc package
# ships an agetty template (/etc/init.d/agetty) but nothing symlinks or
# enables it by default. Without this there's no login prompt on tty1.
set -e
ln -sf agetty /etc/init.d/agetty.tty1
rc-update add agetty.tty1 default

# Autologin as the live user - every mainstream live image (Debian,
# Ubuntu, Kali, ...) does this, there's no password worth typing on a
# live/demo system, and it removes an entire class of "did I type the
# wrong thing" reports for free. openrc's agetty init reads
# `agetty_options` from /etc/conf.d/<service-name> and passes it
# straight through to agetty (see init.d/agetty.in upstream:
# command_args_foreground="${agetty_options} ...") - agetty's own
# `--autologin user` still runs `/bin/login -f user` underneath, so PAM
# session setup and /etc/profile(.d/*) still run exactly as with a
# manual login, just without the prompt.
echo 'agetty_options="--autologin user"' > /etc/conf.d/agetty.tty1

# Devuan's own /etc/inittab (still read by openrc-init - it's an
# inittab-compatible PID 1, confirmed via /proc/1/cmdline on a real
# boot) ships its own tty1 getty respawn entry
# ("1:2345:respawn:/sbin/getty --noclear 38400 tty1"), completely
# independent of the agetty.tty1 OpenRC service just enabled above -
# both fight over the same VT. Confirmed on real hardware: a rapid
# respawn loop, `tty` reporting /dev/console instead of /dev/tty1 (so
# tarno-desktop.sh's tty[1-6] check never matches and labwc never even
# gets a chance to start) - a plain black screen, no autologin, no
# desktop. A VM boot test never hit this, presumably just different
# console/tty wiring under QEMU. Only tty1 conflicts with anything we
# provide - comment out just that one line, tty2-6 stay untouched as
# the documented way to get a manual login on another console (see
# README's "Login" section).
sed -i '/respawn.*getty.*tty1$/ s/^/#/' /etc/inittab

# Second autologin console on ttyS0 (serial), same pattern as tty1
# above - not for real hardware (most laptops have no serial port at
# all, this just idles harmlessly there), it's for the automated QEMU
# boot smoke test (scripts/qemu-smoke-test.py). Real hardware testing
# needs a person; CI needs a console it can reliably reach regardless
# of whatever labwc/seatd/DRM are doing on the "real" tty1/monitor
# console, so bugs there (like the seatd/video-group one this hook's
# git history is from) show up as a failed assertion instead of a
# green build that only "looks" fine. Same "no meaningful password on
# a live/demo system" reasoning as tty1's autologin - this is not a
# new security tradeoff, just the existing one reachable from one more
# device node.
ln -sf agetty /etc/init.d/agetty.ttyS0
rc-update add agetty.ttyS0 default
echo 'agetty_options="--autologin user"' > /etc/conf.d/agetty.ttyS0
