#!/bin/sh
# librsvg dropped `rsvg` for `rsvg-convert` in 2012 - and changed the CLI:
# old `rsvg` took a trailing positional output file, rsvg-convert treats
# all positional args as inputs and wants -o/--output instead. A plain
# name symlink isn't enough (live-build calls
# `rsvg --format png ... splash.svg splash.png`, which rsvg-convert reads
# as two input files) - translate the call instead.
set -e
cat > /usr/bin/rsvg <<'EOF'
#!/bin/sh
set -e
n=$#
i=1
rest=
for a in "$@"; do
	if [ "$i" -lt "$n" ]; then
		rest="$rest $a"
	else
		out=$a
	fi
	i=$((i + 1))
done
# shellcheck disable=SC2086
exec rsvg-convert $rest -o "$out"
EOF
chmod +x /usr/bin/rsvg
