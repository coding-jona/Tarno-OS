name: Build and publish apt repo

on:
  push:
    branches:
      - devel
  workflow_dispatch: {}

permissions:
  contents: read
  pages: write
  id-token: write

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-go@v5
        with:
          go-version: "1.25"

      - name: build tarno-tools.deb
        run: ./scripts/build-deb.sh
        env:
          OUT: dist

      - name: build tarno-os.deb
        run: ./scripts/build-os-deb.sh
        env:
          OUT: dist

      - name: build apt repo
        run: ./scripts/build-apt-repo.sh dist public
        env:
          APT_REPO_GPG_KEY: ${{ secrets.APT_REPO_GPG_KEY }}
          APT_REPO_GPG_KEY_ID: ${{ secrets.APT_REPO_GPG_KEY_ID }}

      - uses: actions/upload-pages-artifact@v3
        with:
          path: public

  deploy:
    needs: build
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - id: deployment
        uses: actions/deploy-pages@v4
