# Tarno OS defconfig für den Dell Precision M6700.
#
# ACHTUNG (siehe docs/month1-foundation.md, Scope-Hinweis): dieses
# defconfig wurde von Hand nach aktueller Buildroot-Manual-Syntax
# geschrieben, aber NICHT gegen einen echten Buildroot-Checkout gebaut
# (kein Buildroot-Build in der Entwicklungs-Sandbox möglich — mehrere GB
# Downloads, Stunden Bauzeit, reale Zielhardware zum Booten). Vor dem
# ersten echten Build:
#
#   make BR2_EXTERNAL=/pfad/zu/tarno-br2-external tarno_m6700_defconfig
#   make menuconfig   # zur Kontrolle/Anpassung an die tatsächliche Hardware
#   make
#
# und Ergebnisse (Fehler, tatsächlicher Idle-RAM-Wert) in
# docs/month1-foundation.md nachtragen.

BR2_x86_64=y

BR2_TOOLCHAIN_BUILDROOT_GLIBC=y

# Kein systemd — OpenRC statt (siehe docs/month1-foundation.md#init-openrc-statt-systemd)
BR2_INIT_OPENRC=y

# Kernel: Standard-x86_64-Kernel-Defconfig als Basis (liefert einen
# lauffähigen Kernel out-of-the-box) + M6700-Fragment obendrauf, das nur
# die für diese konkrete Hardware nötigen Treiber zusätzlich aktiviert
# (AHCI/i915/PS2/Netzwerk/eBPF) — siehe linux.config.fragment.
#
# ACHTUNG (nachgetragen nach dem ersten echten CI-Build, siehe
# .github/workflows/build-os-image.yml): BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG
# allein (ohne BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE) reicht NICHT -
# CONFIG_FRAGMENT_FILES ist nur ein Zusatz obendrauf, keine eigenständige
# Kernel-Konfigurationsquelle. Erster Build schlug deshalb sofort mit
# "No kernel configuration file specified" fehl - dieser Commit behebt das
# durch BR2_LINUX_KERNEL_USE_DEFCONFIG als Basis.
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_USE_DEFCONFIG=y
BR2_LINUX_KERNEL_DEFCONFIG="x86_64"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="board/tarno-m6700/linux.config.fragment"
BR2_LINUX_KERNEL_BZIMAGE=y

# tarnod (dieser BR2_EXTERNAL-Tree)
BR2_PACKAGE_TARNOD=y

# Minimaler Wayland-Compositor für Direct-Fullscreen (siehe
# docs/month1-foundation.md#compositor-cage)
BR2_PACKAGE_CAGE=y

# Rootfs-Overlay: tarnod-OpenRC-Service (etc/init.d/tarnod +
# etc/runlevels/default/tarnod-Symlink)
BR2_ROOTFS_OVERLAY="board/tarno-m6700/rootfs-overlay"

BR2_TARGET_GENERIC_GETTY_PORT="ttyS0"

# USB-Boot-Image (Anforderung: per dd auf einen Stick schreibbar, bootet
# direkt ohne separaten Installer) — siehe
# docs/month1-foundation.md#usb-boot-image-anforderung-installationauslieferung-per-usb-stick
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
# Stellt host-syslinux (u.a. mbr.bin) bereit, das post-image.sh für den
# MBR-Bootstrap-Code braucht.
BR2_TARGET_SYSLINUX=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_ROOTFS_POST_IMAGE_SCRIPT="board/tarno-m6700/post-image.sh"
